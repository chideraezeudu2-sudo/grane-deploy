{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["widget/**", "db/**", "routes/**", "middleware/**", "services/**"],
        "excludeFiles": ["node_modules/**"]
      }
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/widget.js", "dest": "/widget/apppulse.js" },
    { "src": "/(.*)", "dest": "/dist/$1" }
  ],
  "installCommand": "npm install"
}
